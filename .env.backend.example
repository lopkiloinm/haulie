# Server-only: add these in Vercel Project Settings > Environment Variables.
# The responsive demo remains available without any live credentials.
APP_ORIGIN=https://your-project.vercel.app
DATABASE_URL=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Set true ONLY for a disposable local Postgres server; ignored in production.
DATABASE_LOCAL_INSECURE=false

# World Developer Portal app, RP registration, signing key, and uniqueness action.
# Never expose WORLD_SIGNING_KEY or SESSION_SECRET with a NEXT_PUBLIC_ prefix.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENROLLMENT_ACTION=haulie-enrollment
WORLD_ENVIRONMENT=staging

# Also configure .env.sui.example after publishing the Move package.

# Official World for Agents sandbox OIDC (separate from IDKit staging above).
# Register client_secret_basic with this exact HTTPS callback:
# https://haulie-chi.vercel.app/api/world-sandbox/callback
WORLD_SANDBOX_CLIENT_ID=
WORLD_SANDBOX_CLIENT_SECRET=
# Generate a separate random secret of at least 32 characters (openssl rand -hex 32).
WORLD_SANDBOX_SESSION_SECRET=
WORLD_SANDBOX_ORIGIN=https://haulie-chi.vercel.app
